# 智修 V1.2 环境变量示例：复制为 .env 后按需修改
# 后端与脚本均通过 services/api/app/config.py 读取（env_file=".env"）。

# 应用
APP_NAME=zhixiu-v12
ENV=local

# 数据库：本地零依赖用 SQLite；Compose 用 PostgreSQL
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://zhixiu:zhixiu@postgres:5432/zhixiu

# 认证
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
# 安全硬化（生产环境 ENV=prod 时密钥不足直接拒绝启动）
JWT_MIN_SECRET_BYTES=32
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20

# 存储与追踪
UPLOAD_DIR=data/uploads
TRACE_DIR=data/traces
REPORT_DIR=data/reports
MAX_UPLOAD_BYTES=10485760

# AI Provider：ollama（默认）或 mock（离线确定性回退）
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT=180
# 留空时 Embedding 走本地 MockEmbedder，不依赖 Ollama 的 embedding 接口
OLLAMA_EMBEDDING_MODEL=
EMBEDDING_DIM=768
OCR_PROVIDER=mock

# 诊断参数
MIN_CONFIDENCE=0.5
RELEVANCE_THRESHOLD=0.15
MAX_PROBE_STEPS=5

# 前端（Next.js 构建期注入）
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Compose 中的 MinIO（本轮 API 使用本地对象存储，仅保留服务位）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin